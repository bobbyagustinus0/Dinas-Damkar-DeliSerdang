PORT=8081

# ============================================================
# DATABASE MYSQL BERSAMA (SAMA dengan database E-Survey)
# ============================================================
# Backend Damkar menyimpan cache survei & jawaban ke tabel dinas_survey_cache /
# dinas_survey_jawaban di database MySQL YANG SAMA dipakai E-Survey. Isi sesuai
# kredensial database E-Survey (lihat e-survey-deliserdang31/.env).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_survey_deliserdang
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# INTEGRASI E-SURVEY DELI SERDANG (tetap lewat API, TIDAK berubah)
# ============================================================

# API Key yang dipakai E-Survey untuk mengakses API Damkar (header: Authorization: Bearer <ini>).
# Isi juga nilai yang SAMA PERSIS ke kolom "API Key" di menu Integrasi dashboard E-Survey.
DAMKAR_API_KEY=damkar-survey-2026-secret

# Token webhook dari E-Survey. Didapat setelah klik "Generate Ulang Token"
# di menu Integrasi E-Survey, lalu tempel nilainya di sini.
ESURVEY_WEBHOOK_TOKEN=sZvQpnisvskwks9UNNa2BXVUeqHfRAf0n8IIGmH40i9CFObNB9Fjg0eN1HDSXS8v

# Alamat endpoint webhook E-Survey (isi sesuai alamat aplikasi E-Survey yang dipakai).
ESURVEY_WEBHOOK_URL=http://127.0.0.1:8000/api/webhook/survey-jawaban
